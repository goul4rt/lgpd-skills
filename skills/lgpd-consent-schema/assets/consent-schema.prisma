// Consent Event Ledger — append-only orientado a eventos, versionado e auditável.
// LGPD Art. 7º, I; Art. 8º (§§ 2º, 4º, 5º e 6º); Art. 9º; Art. 14; Art. 18, IX.
// ECA Digital (Lei nº 15.211/2025, Art. 24) para vinculação de responsável até 16 anos.

enum ConsentEventType {
  GRANTED    // Consentimento concedido para finalidade e versão específicas
  REVOKED    // Consentimento revogado pelo titular ou responsável (Art. 8º, § 5º)
  SUPERSEDED // Substituído por mudança material de finalidade/política (Art. 8º, § 6º)
  EXPIRED    // Expirado automaticamente quando houver prazo de validade (TTL)
}

enum ConsentChannel {
  WEB
  MOBILE_RN
  API
  SIGNUP
  SETTINGS_PAGE
  EMAIL_OPTIN
  COOKIE_BANNER
}

model PolicyVersion {
  id                String         @id @default(cuid())
  version           String         @unique // ex.: "v3.2"
  effectiveAt       DateTime
  requiresReconsent Boolean        @default(false) // Art. 8º, § 6º — mudança material exige nova coleta
  text              String         @db.Text
  textHash          String         // SHA-256 do texto canônico publicado
  language          String         @default("pt-BR")
  changelog         String?        @db.Text

  events            ConsentEvent[]

  @@index([effectiveAt])
}

model ConsentEvent {
  id              String           @id @default(cuid())
  seq             BigInt           @unique @default(autoincrement()) // desempate monotônico determinístico

  // Titular e finalidade específica (Art. 8º, § 4º)
  subjectId       String           // FK lógica para User
  purpose         String           // ex.: "marketing_email", "analytics_cookies", "biometric_optin"

  // Semântica de evento imutável (nunca sobrescrever registro anterior)
  eventType       ConsentEventType
  occurredAt      DateTime         @default(now())
  expiresAt       DateTime?        // aplicável apenas em eventos GRANTED com TTL

  // Linhagem: eventos REVOKED / SUPERSEDED / EXPIRED apontam para o GRANTED original
  rootConsentId   String?
  rootConsent     ConsentEvent?    @relation("ConsentLineage", fields: [rootConsentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  derivedEvents   ConsentEvent[]   @relation("ConsentLineage")

  // Versão exata da política associada ao evento
  policyVersionId String
  policyVersion   PolicyVersion    @relation(fields: [policyVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Evidência probatória (Art. 8º, § 2º — ônus da prova cabe ao controlador)
  evidenceHash    String           // SHA-256 canônico da evidência do evento
  ipAddress       String?          @db.Inet
  userAgent       String?
  locale          String           @default("pt-BR")
  channel         ConsentChannel
  uiSnapshot      String?          @db.Text // hash ou snapshot do componente/texto exibido

  // Crianças e adolescentes (Art. 14 LGPD + Enunciado 1/2023 + ECA Digital)
  isMinor         Boolean          @default(false)
  parentalConsent Boolean?         // true quando consentimento parental específico foi colhido (Art. 14, § 1º)
  guardianId      String?
  guardian        Guardian?        @relation(fields: [guardianId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Rastreabilidade de propagação a operadores (Art. 18, § 6º)
  propagatedTo    Json?            // ex.: ["mixpanel", "customer_io"]

  @@index([subjectId, purpose, occurredAt(sort: Desc), seq(sort: Desc)])
  @@index([rootConsentId])
  @@index([policyVersionId])
}

// Vinculação a responsável legal (Art. 14, § 1º LGPD / Art. 24 Lei 15.211/2025 até 16 anos)
model Guardian {
  id                 String         @id @default(cuid())
  fullName           String
  cpfCiphertext      String         // cifrado em nível de aplicação (AES-256-GCM + KMS)
  cpfBlindIndex      String         // HMAC-SHA256 com chave segregada para busca exata
  email              String
  phone              String?
  relationship       String         // "mother", "father", "legal_guardian"
  verifiedAt         DateTime?
  verificationMethod String?        // "gov_br", "id_doc_liveness", "os_age_signal"

  minors             MinorLink[]
  consentEvents      ConsentEvent[]

  createdAt          DateTime       @default(now())

  @@index([cpfBlindIndex])
}

model MinorLink {
  id          String    @id @default(cuid())
  minorUserId String
  guardianId  String
  guardian    Guardian  @relation(fields: [guardianId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  endedAt     DateTime?

  @@unique([minorUserId, guardianId])
}
